# Use production only on the deployed server.
APP_ENV=development

# Required when APP_ENV=production. Generate a long random value.
SECRET_KEY=

# Local development default: sqlite:///helpdesk.db
# PostgreSQL example: postgresql+psycopg://username:password@host:5432/helpdeskpro
DATABASE_URL=sqlite:///helpdesk.db

# Set to 1 on EC2 when Nginx is the only public entry point.
TRUSTED_PROXY_COUNT=0

# Keep true for an HTTPS deployment. Set false only while temporarily testing
# the site through an HTTP-only IP address before a domain and TLS are ready.
SESSION_COOKIE_SECURE=true

# Timezone used when dates and times are displayed to staff and users.
DISPLAY_TIMEZONE=Africa/Lagos

# SMTP configuration for password reset emails.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true

# Send email alerts for ticket replies, progress updates, and resolutions.
MAIL_TICKET_NOTIFICATIONS=true
